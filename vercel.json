{
  "rewrites": [
    { "source": "/context/:role", "destination": "/api/context/[role]" },
    { "source": "/contribute", "destination": "/api/contribute" },
    { "source": "/ask", "destination": "/api/ask" },

    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-server" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth-server" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-server" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth-server" },
    { "source": "/authorize", "destination": "/api/oauth-server" },
    { "source": "/token", "destination": "/api/oauth-server" },
    { "source": "/register", "destination": "/api/oauth-server" },
    { "source": "/revoke", "destination": "/api/oauth-server" },
    { "source": "/oauth/:path*", "destination": "/api/oauth-server" },
    { "source": "/settings", "destination": "/api/oauth-server" },
    { "source": "/settings/:path*", "destination": "/api/oauth-server" }
  ]
}
